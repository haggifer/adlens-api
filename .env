# Non-secret runtime config for the Functions (loaded by the Firebase CLI in both the emulator and
# on deploy). Gemini uses Vertex AI via ADC — there is no API key to configure here.

# Must match the frontend's NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET so both SDKs use the same bucket.
STORAGE_BUCKET=adlens-ca57f.firebasestorage.app

# Optional Gemini model override (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional extra CORS origins for the API (comma-separated); localhost is always allowed.
# ALLOWED_ORIGINS=https://your-frontend-domain

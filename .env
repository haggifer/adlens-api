# Non-secret runtime config for the NestJS API + worker (loaded via @nestjs/config).
# Secrets (MONGODB_URI, BETTER_AUTH_SECRET) live in the gitignored .env.local, not here. Every variable is
# validated at startup by src/config/env.ts.
# This file ships in the production image, so its values apply to local runs, the API and both Cloud Run jobs alike:
# put only values meant for production here. Local overrides go in .env.local; Cloud Run env vars (infra/setup.sh)
# also take precedence over it.

# GCP project for Vertex (Gemini) and Cloud Storage, both via ADC.
GOOGLE_CLOUD_PROJECT=adlens-ca57f

# Better Auth: the API's own public base URL, and the single web origin allowed to call the API (CORS,
# Socket.IO and Better Auth trusted origin). BETTER_AUTH_SECRET is in .env.local.

# GCS bucket for uploads (signed URLs) — EU (europe-west1), co-located with compute.
STORAGE_BUCKET=adlens-ca57f-uploads

# STORAGE_KEY_FILE (set in .env.local for local dev only): path to a service-account JSON key used
# solely by the Storage client to sign V4 upload URLs, since user ADC cannot. Leave unset in prod —
# Cloud Run's runtime SA signs via default ADC.

# Analyses per confirmed account per rolling 7-day window (anonymous users and unconfirmed accounts get 1).
QUOTA_LIMIT=3

# Optional Gemini overrides (defaults: model gemini-3.8-flash, location global).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global

# Non-secret runtime config for the NestJS API + worker (loaded via @nestjs/config).
# Secrets (MONGODB_URI, JWT_SECRET) live in the gitignored .env.local, not here.

# GCP project for Vertex (Gemini) and Cloud Storage, both via ADC.
GOOGLE_CLOUD_PROJECT=adlens-ca57f

# Better Auth: the API's own public base URL, and the web origin(s) allowed to authenticate (CORS +
# trusted origins). Comma-separate multiple web origins. BETTER_AUTH_SECRET is in .env.local.
BETTER_AUTH_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000

# GCS bucket for uploads (signed URLs) and result.json. Moves to the new EU bucket when provisioned.
STORAGE_BUCKET=adlens-ca57f.firebasestorage.app

# Weekly analysis quota per user.
# QUOTA_LIMIT=3

# Optional Gemini overrides (defaults: model gemini-3.6-flash, location global).
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_LOCATION=global

# Extra CORS origins (comma-separated); localhost is always allowed.
# ALLOWED_ORIGINS=https://your-frontend-domain

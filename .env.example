# Copy the secret and local-only values into .env.local (gitignored). Non-secret runtime config
# lives in the committed .env; the full variable list is documented in the README (Environment).

# Path to a mounted JSON file of secrets (production only: Secret Manager's API_SECRETS, see infra/setup.sh).
# Leave unset locally — its keys only fill gaps in the environment, never override .env.local.
# SECRETS_FILE=

# --- required secrets (set in .env.local) ---
# MongoDB Atlas connection string for the `adlens` database.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/adlens?retryWrites=true&w=majority
# Better Auth signing secret — a long random string.
BETTER_AUTH_SECRET=
# Resend sending key for verification, password-reset and Contact emails. Required: the API won't start without it,
# and a request whose email can't be sent fails with 503.
RESEND_API_KEY=

# --- optional: the Contact form (set in .env.local) ---
# The address Contact form messages are sent to. Unset, the Contact endpoints answer 503; an empty value fails the
# email check and stops the API from starting, so leave it commented out until you have one.
# CONTACT_EMAIL=you@example.com

# --- optional: sign in with Google / GitHub (set in .env.local) ---
# The local OAuth apps' credentials. Each provider needs both values or neither; their callback URLs are
# http://localhost:8080/api/auth/callback/google and .../github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Publicly readable bucket of demo and sample videos (infra/setup.sh creates it); unset, they're signed like any
# other object.
PUBLIC_MEDIA_BUCKET=

# --- local development only ---
# Run each analysis as a local child process (node dist/worker) instead of a Cloud Run Job execution.
# Needs a build first (npm run build, or npm run start:dev, which keeps dist/ current).
ANALYZE_LOCAL=1
# Service-account key so the Storage client can sign V4 upload URLs locally (user ADC cannot sign).
# Leave unset in production — Cloud Run's runtime service account signs via ADC.
STORAGE_KEY_FILE=

# GCP auth for Vertex AI + Cloud Storage is via Application Default Credentials (ADC):
#   deployed: the Cloud Run runtime service account
#   local:    run `gcloud auth application-default login`
# Cloudflare Turnstile. Locally the always-pass test secret; 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

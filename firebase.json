{
    "functions": [
        {
            "source": ".",
            "codebase": "adlens-api",
            "runtime": "nodejs20",
            "ignore": ["node_modules", ".git", "*.log", "src", "tsconfig.json"],
            "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
        }
    ],
    "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
    "storage": { "rules": "storage.rules" },
    "emulators": {
        "auth": { "port": 9099 },
        "functions": { "port": 5001 },
        "firestore": { "port": 8080 },
        "storage": { "port": 9199 },
        "ui": { "enabled": true },
        "singleProjectMode": true
    }
}

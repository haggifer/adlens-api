{
    "name": "adlens-api",
    "version": "0.2.0",
    "private": true,
    "description": "AdLens backend — NestJS API + on-demand Cloud Run analysis Job (MongoDB, GCS, Gemini on Vertex)",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "start:job": "node dist/job",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "jest",
        "test:e2e": "jest --config test/jest-e2e.json",
        "check:deps": "node scripts/check-no-file-deps.mjs"
    },
    "dependencies": {
        "@google-cloud/run": "^4.1.0",
        "@google-cloud/storage": "^7.14.0",
        "@google/genai": "^1.0.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/mongoose": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-socket.io": "^11.0.0",
        "@nestjs/websockets": "^11.0.0",
        "adlens-shared": "0.2.0",
        "better-auth": "^1.7.4",
        "ffprobe-static": "^3.1.0",
        "mongodb": "^6.12.0",
        "mongoose": "^8.9.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.0.0",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.9.5",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.0.0"
    }
}

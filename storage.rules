rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Each upload lives under users/{uid}/{timestamp}/. The one direct client write is the video
    // binary into the user's own folder; derived files (result.json) are written server-side.
    match /users/{uid}/{session}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 200 * 1000 * 1000        // 200 MB (decimal, matches the client)
                   && request.resource.contentType.matches('video/.*');
    }
  }
}
